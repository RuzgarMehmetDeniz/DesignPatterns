@model List<DesignPatterns.Entites.Sale>
@{
    ViewData["Title"] = "Satış & Kampanya Yönetimi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm" style="border-radius: 15px;">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center p-4">
            <h4 class="fw-bold m-0 text-dark"><i class="fas fa-tag text-danger me-2"></i>Aktif Kampanyalar</h4>
            <a href="/AdminSale/CreateSale" class="btn btn-danger btn-sm rounded-pill px-4 shadow-sm">
                <i class="fas fa-plus me-2"></i>Yeni Kampanya Ekle
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4">Kampanya Görseli</th>
                            <th>Başlıklar</th>
                            <th>Açıklama</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <img src="@item.ImageUrl" class="rounded shadow-sm" style="width: 80px; height: 50px; object-fit: cover;">
                                </td>
                                <td>
                                    <div class="fw-bold">@item.Title1</div>
                                    <div class="text-danger small fw-semibold">@item.Title2</div>
                                </td>
                                <td><small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@item.Description</small></td>
                                <td class="text-center">
                                    <a href="/AdminSale/UpdateSale/@item.SaleId" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">Düzenle</a>
                                    <a href="/AdminSale/DeleteSale/@item.SaleId" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Kampanyayı silmek istediğinize emin misiniz?')">Sil</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>