@model DesignPatterns.Entites.Trend
@{
    ViewData["Title"] = "Yeni Trend";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <h5 class="fw-bold mb-4 border-bottom pb-3">Yeni Trend Tanımla</h5>
                <form asp-action="CreateTrend" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Görsel URL</label>
                        <input type="text" asp-for="ImageUrl" class="form-control bg-light border-0 py-2" placeholder="https://..." style="border-radius: 10px;">
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-bold">Trend Açıklaması</label>
                        <textarea asp-for="Description" rows="4" class="form-control bg-light border-0" placeholder="Trend içeriği hakkında kısa bilgi..." style="border-radius: 12px;"></textarea>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-dark rounded-pill py-2 shadow">Trendi Yayınla</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>