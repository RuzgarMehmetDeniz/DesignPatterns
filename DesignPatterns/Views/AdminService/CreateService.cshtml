@model DesignPatterns.Entites.Service
@{
    ViewData["Title"] = "Yeni Hizmet";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <h5 class="fw-bold mb-4 border-bottom pb-3"><i class="fas fa-plus-circle text-info me-2"></i>Hizmet Tanımla</h5>
                <form asp-action="CreateService" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Hizmet Başlığı</label>
                        <input type="text" asp-for="ServiceTitle" class="form-control bg-light border-0 py-2" placeholder="Örn: Hızlı Teslimat" style="border-radius: 10px;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">İkon veya Görsel URL</label>
                        <input type="text" asp-for="ImageUrl" class="form-control bg-light border-0 py-2" placeholder="https://..." style="border-radius: 10px;">
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-bold">Kısa Açıklama</label>
                        <textarea asp-for="Description" rows="3" class="form-control bg-light border-0" placeholder="Hizmet detaylarını giriniz..." style="border-radius: 12px;"></textarea>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-info text-white rounded-pill py-2 shadow">Hizmeti Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>