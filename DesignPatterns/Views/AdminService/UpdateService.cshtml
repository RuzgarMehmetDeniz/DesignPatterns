@model DesignPatterns.Entites.Service
@{
    ViewData["Title"] = "Hizmet Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <div class="text-center mb-4 border-bottom pb-3">
                    <div class="bg-soft-info rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <img src="@Model.ImageUrl" style="width: 40px;">
                    </div>
                    <h5 class="fw-bold">Hizmet Detaylarını Güncelle</h5>
                </div>

                <form asp-action="UpdateService" method="post">
                    <input type="hidden" asp-for="ServiceId" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Hizmet Başlığı</label>
                        <input type="text" asp-for="ServiceTitle" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Görsel URL</label>
                        <input type="text" asp-for="ImageUrl" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-bold">Açıklama</label>
                        <textarea asp-for="Description" rows="4" class="form-control bg-light border-0" style="border-radius: 12px;">@Model.Description</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 shadow-sm">Değişiklikleri Uygula</button>
                </form>
            </div>
        </div>
    </div>
</div>