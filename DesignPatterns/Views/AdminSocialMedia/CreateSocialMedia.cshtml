@model DesignPatterns.Entites.SocialMedia
@{
    ViewData["Title"] = "Yeni Sosyal Medya";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <h5 class="fw-bold mb-4 border-bottom pb-3">Yeni Bağlantı Tanımla</h5>
                <form asp-action="CreateSocialMedia" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Platform Adı (Title)</label>
                        <input type="text" asp-for="Title" class="form-control bg-light border-0 py-2" placeholder="Örn: Instagram" style="border-radius: 10px;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">FontAwesome İkonu (Icon)</label>
                        <input type="text" asp-for="Icon" class="form-control bg-light border-0 py-2" placeholder="fab fa-instagram" style="border-radius: 10px;">
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Görsel URL 1</label>
                            <input type="text" asp-for="ImageUrl1" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Görsel URL 2</label>
                            <input type="text" asp-for="ImageUrl2" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                    </div>
                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary rounded-pill py-2 shadow">Bağlantıyı Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>