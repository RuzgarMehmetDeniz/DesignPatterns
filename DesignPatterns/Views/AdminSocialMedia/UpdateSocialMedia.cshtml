@model DesignPatterns.Entites.SocialMedia
@{
    ViewData["Title"] = "Sosyal Medya Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <div class="text-center mb-4 border-bottom pb-3">
                    <i class="@Model.Icon fa-3x text-primary mb-3"></i>
                    <h5 class="fw-bold">Bağlantıyı Güncelle</h5>
                </div>

                <form asp-action="UpdateSocialMedia" method="post">
                    <input type="hidden" asp-for="SocialMediaId" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Platform Adı</label>
                        <input type="text" asp-for="Title" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">İkon Sınıfı</label>
                        <input type="text" asp-for="Icon" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Görsel 1</label>
                        <input type="text" asp-for="ImageUrl1" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-bold">Görsel 2</label>
                        <input type="text" asp-for="ImageUrl2" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                    </div>
                    <button type="submit" class="btn btn-success w-100 rounded-pill py-2 shadow-sm">Değişiklikleri Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>