@model DesignPatterns.Models.CustomerProcessViewModel
@{
    Layout = null;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center rounded-top-4 py-3">
                    <h4 class="mb-0">Para Çekme İşlemi</h4>
                </div>

                <div class="card-body p-4">
                    <form method="post">

                        <div class="mb-3">
                            <label asp-for="CustomerName" class="form-label fw-semibold">
                                Müşteri Adı
                            </label>
                            <input asp-for="CustomerName"
                                   class="form-control"
                                   placeholder="Müşteri adını giriniz" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-semibold">
                                Çekilecek Tutar
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input asp-for="Amount"
                                       class="form-control"
                                       placeholder="Örn: 2500" />
                            </div>
                        </div>

                        <div class="alert alert-info small">
                            Lütfen para çekme işlemi için müşteri adını ve çekilecek tutarı doğru giriniz.
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary py-2">
                                Para Çekme İşlemini Kaydet
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>