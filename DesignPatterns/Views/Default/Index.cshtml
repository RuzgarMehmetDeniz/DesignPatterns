@{
	Layout = null;
}

<!DOCTYPE html>

<html lang="en">
    @await Component.InvokeAsync("DefaultHeadComponentPartial")

<body>

	<div class="body-wrap overflow-hidden">

		<div class="backtotop">
			<a href="#!" class="scroll">
				<i class="far fa-arrow-up fw-bold"></i>
			</a>
		</div>

		@await Component.InvokeAsync("_DefaultHeaderComponentPartial")


		<!-- main body start -->
		<main>
			@await Component.InvokeAsync("_DefaultSidebarComponentPartial")

			@* Banner Alanı *@
			@await Component.InvokeAsync("_DefaultBannerComponentPartial")

			@* Service Alanı *@
			@await Component.InvokeAsync("_DefaultServiceComponentPartial")

			@* Hakkımızda Bölümü *@
			@await Component.InvokeAsync("_DefaultProductComponentPartial")

			@* Trend Alanı *@
			@await Component.InvokeAsync("_DefaultTrendComponentPartial")

			@* Taze Ürünler Alanı *@
			@await Component.InvokeAsync("_DefaultQuealityComponentPartial")

			@* Satış Alanı *@
			@await Component.InvokeAsync("_DefaultSaleComponentPartial")

			@* Ürün Listeleme Alanı *@
			@await Component.InvokeAsync("_DefaultProductSectionComponentPartial")

			@* Blog Alanı *@
			@await Component.InvokeAsync("_DefaultBlogComponentPartial")

			@* Testimonial Alanı *@
			@await Component.InvokeAsync("_DefaultTestimonialComponentPartial")

			@* İnstagram Alanı*@
			@await Component.InvokeAsync("_DefaultInstagramComponentPartial")

			@* Marka Alanı *@
			@await Component.InvokeAsync("_DefaultBrandComponentPartial")
			<!-- brand section end -->
		</main>

		<!-- main body end -->
		<!-- footer section start -->
		@await Component.InvokeAsync("_DefaultFooterComponentPartial")
		<!-- footer section end -->
		<!-- quick-view start -->
		@await Component.InvokeAsync("_DefaultQuickViewComponentPartial")
		<!-- quick-view end -->
	</div>
	@await Component.InvokeAsync("_DefaultScriptComponentPartial")

</body>

</html>