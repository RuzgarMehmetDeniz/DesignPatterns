@model DesignPatterns.Entites.Brand
@{
    ViewData["Title"] = "Marka Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm p-5" style="border-radius: 20px;">
                <div class="text-center mb-4">
                    <i class="fas fa-copyright fa-3x text-primary mb-3"></i>
                    <h5 class="fw-bold">Yeni Marka Logosu</h5>
                </div>
                <form asp-action="CreateBrand" method="post">
                    <div class="mb-4">
                        <label class="form-label small fw-bold">Logo URL (ImageUrl)</label>
                        <input type="text" asp-for="ImageUrl" class="form-control bg-light border-0 py-3" placeholder="https://marka-logo-linki.com/logo.png" style="border-radius: 12px;">
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill py-3 fw-bold">Kaydet</button>
                        <a href="/AdminBrand/BrandList" class="btn btn-link text-secondary text-decoration-none small text-center">Listeye Dön</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>