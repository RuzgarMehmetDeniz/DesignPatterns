@model List<DesignPatterns.Entites.Brand>
@{
    ViewData["Title"] = "Marka Yönetimi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm" style="border-radius: 15px;">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center p-4">
            <h4 class="fw-bold m-0 text-dark">Çalıştığımız Markalar</h4>
            <a href="/AdminBrand/CreateBrand" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm">
                <i class="fas fa-plus me-2"></i>Yeni Marka Logosu Ekle
            </a>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 border-0 shadow-sm text-center p-3" style="border-radius: 15px; transition: transform 0.3s;">
                            <div class="d-flex align-items-center justify-content-center" style="height: 100px;">
                                <img src="@item.ImageUrl" class="img-fluid" style="max-height: 80px; object-fit: contain;" alt="Brand Logo">
                            </div>
                            <div class="card-footer bg-transparent border-0 mt-2">
                                <div class="btn-group w-100">
                                    <a href="/AdminBrand/UpdateBrand/@item.BrandId" class="btn btn-sm btn-outline-info rounded-start">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="/AdminBrand/DeleteBrand/@item.BrandId" class="btn btn-sm btn-outline-danger rounded-end" onclick="return confirm('Markayı silmek istediğinize emin misiniz?')">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .card:hover {
        transform: translateY(-5px);
    }
</style>