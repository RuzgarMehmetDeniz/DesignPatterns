@model DesignPatterns.Entites.Brand
@{
    ViewData["Title"] = "Marka Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm p-5" style="border-radius: 20px;">
                <div class="text-center mb-4 border-bottom pb-4">
                    <div class="mb-3">
                        <img src="@Model.ImageUrl" class="img-thumbnail border-0" style="max-height: 100px; background: #f8f9fa;">
                    </div>
                    <h5 class="fw-bold">Marka Logosunu Güncelle</h5>
                </div>

                <form asp-action="UpdateBrand" method="post">
                    <input type="hidden" asp-for="BrandId" />

                    <div class="mb-4">
                        <label class="form-label small fw-bold">Logo URL</label>
                        <input type="text" asp-for="ImageUrl" class="form-control bg-light border-0 py-3" style="border-radius: 12px;">
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-info text-white rounded-pill py-3 fw-bold shadow">Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>