@model DesignPatterns.Entites.CustomerProcess
@{
    ViewData["Title"] = "Yeni İşlem";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-7">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <h5 class="fw-bold mb-4 border-bottom pb-3"><i class="fas fa-file-invoice text-primary me-2"></i>Yeni Süreç Tanımla</h5>
                <form asp-action="CreateProcess" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Müşteri Adı</label>
                            <input type="text" asp-for="CustomerName" class="form-control bg-light border-0 px-3 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Sorumlu Personel</label>
                            <input type="text" asp-for="EmployeeName" class="form-control bg-light border-0 px-3 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">İşlem Tutarı (₺)</label>
                            <input type="text" asp-for="Amount" class="form-control bg-light border-0 px-3 py-2 fw-bold text-success" placeholder="0.00" style="border-radius: 10px;">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">İşlem Detayı / Açıklama</label>
                            <textarea asp-for="Description" rows="4" class="form-control bg-light border-0" style="border-radius: 12px;"></textarea>
                        </div>
                        <div class="col-12 mt-4 text-end">
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 shadow">İşlemi Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>