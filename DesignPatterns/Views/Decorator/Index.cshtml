@model List<DesignPatterns.Entites.Product>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Premium Market - Ürün Listesi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            font-family: 'Quicksand', sans-serif;
            background-color: #f8f9fa;
        }

        .product-card {
            border: none;
            border-radius: 15px;
            transition: 0.3s;
            background: #fff;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

            .product-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 15px 30px rgba(0,0,0,0.1);
            }

        .discount-badge {
            background: #8bc34a;
            color: white;
            padding: 5px 15px;
            border-radius: 50px;
            font-size: 11px;
            position: absolute;
            top: 15px;
            right: 15px;
        }

        .btn-add-cart {
            background: #222;
            color: white;
            border-radius: 50px;
            border: none;
            padding: 10px 20px;
            transition: 0.3s;
            text-decoration: none;
            display: block;
            text-align: center;
        }

            .btn-add-cart:hover {
                background: #8bc34a;
                color: white;
            }
    </style>
</head>

@await Component.InvokeAsync("_DefaultHeaderComponentPartial")

<body>
    <div class="container py-5">
        <h2 class="text-center mb-5 fw-bold text-uppercase" style="letter-spacing: 2px;">Taze Ürünler</h2>

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card product-card h-100 p-3 position-relative">
                        <span class="discount-badge">ÖZEL İNDİRİM</span>
                        <img src="@item.ImageUrl" class="card-img-top p-4" style="height: 200px; object-fit: contain;" alt="@item.Name">
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold">@item.Name</h5>
                            @* Decorator indirimli fiyatı gösterir *@
                            <p class="card-text text-success fw-bold fs-4">₺@item.Price.ToString("N2")</p>

                            @* Controller'daki AddToCart aksiyonuna yönlendirme *@
                            <a href="/Decorator/AddToCart/@item.ProductId" class="btn-add-cart">
                                <i class="fas fa-shopping-basket me-2"></i> SEPETE EKLE
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Sayfalama *@
        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="/Decorator/Index?page=@(ViewBag.CurrentPage - 1)">Geri</a>
                </li>
                @for (int i = 1; i <= 3; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link" href="/Decorator/Index?page=@i">@i</a>
                    </li>
                }
                <li class="page-item">
                    <a class="page-link" href="/Decorator/Index?page=@(ViewBag.CurrentPage + 1)">İleri</a>
                </li>
            </ul>
        </nav>
    </div>

    @await Component.InvokeAsync("_DefaultScriptComponentPartial")
</body>
</html>