@model List<DesignPatterns.Entites.AboutSection>
@{
    ViewData["Title"] = "Hakkımızda Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm" style="border-radius: 15px; background: rgba(255,255,255,0.95);">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center p-4">
            <h4 class="fw-bold text-dark m-0">Hakkımızda Bölümleri</h4>
            <a href="/AdminAbout/CreateAbout" class="btn btn-success btn-sm rounded-pill px-4">
                <i class="fas fa-plus me-2"></i>Yeni Ekle
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr class="small text-uppercase text-muted">
                            <th class="ps-4">Görsel</th>
                            <th>Başlıklar</th>
                            <th>Açıklama 1</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <img src="@item.ImageUrl" class="rounded shadow-sm" style="width: 60px; height: 40px; object-fit: cover;" />
                                </td>
                                <td>
                                    <div class="fw-bold">@item.Title1</div>
                                    <div class="small text-muted">@item.Title2</div>
                                </td>
                                <td>
                                    <div class="small text-truncate" style="max-width: 200px;">@item.Description1</div>
                                </td>
                                <td class="text-center">
                                    <a href="/AdminAbout/UpdateAbout/@item.AboutSectionId" class="btn btn-sm btn-info text-white rounded-pill px-3">Düzenle</a>
                                    <a href="/AdminAbout/DeleteAbout/@item.AboutSectionId" class="btn btn-sm btn-danger rounded-pill px-3" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>