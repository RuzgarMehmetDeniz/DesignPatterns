@model List<DesignPatterns.Entites.Product>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Premium Organic Shop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
        }

        .product-card {
            border: 1.5px solid #8cc63f;
            border-radius: 35px;
            background-color: #fff;
            transition: all 0.3s ease;
            height: 100%;
        }

            .product-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            }

        .badge-category {
            background-color: #f3f9eb;
            color: #8cc63f;
            font-size: 11px;
            padding: 6px 15px;
            border-radius: 20px;
            font-weight: 600;
        }

        .badge-discount {
            background-color: #ff5a30;
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            font-size: 11px;
            font-weight: bold;
        }

        .price-text {
            color: #8cc63f;
            font-size: 1.3rem;
            font-weight: 700;
        }

        .pagination .page-link {
            border-radius: 50% !important;
            margin: 0 5px;
            color: #8cc63f;
            border: 1px solid #8cc63f;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pagination .active .page-link {
            background-color: #8cc63f;
            border-color: #8cc63f;
            color: white;
        }
    </style>
</head>

@await Component.InvokeAsync("_DefaultHeaderComponentPartial")

<body>
    <!-- Sabit Sepete Git Butonu -->
    <div class="position-fixed bottom-0 end-0 m-4" style="z-index: 1000;">
        <a asp-controller="Basket" asp-action="Index" class="btn btn-dark btn-lg shadow-lg rounded-pill px-4 py-3 d-flex align-items-center">
            <div class="bg-success rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px;">
                <i class="fas fa-shopping-basket text-white small"></i>
            </div>
            <span class="fw-bold">Sepete Git</span>
        </a>
    </div>

    <div class="container py-5">
        <h2 class="text-center mb-5 fw-bold text-dark">Organik Ürünlerimiz</h2>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="product-card p-3 shadow-sm d-flex flex-column">
                        <div class="position-relative text-center">
                            <span class="badge-category position-absolute top-0 start-0">@item.Category.Name.ToUpper()</span>
                            <div class="badge-discount position-absolute top-0 end-0 d-flex align-items-center justify-content-center">-27%</div>
                            <img src="@item.ImageUrl" class="img-fluid mt-4" alt="@item.Name" style="height: 180px; object-fit: contain;">
                        </div>

                        <div class="mt-3 ps-2 flex-grow-1">
                            <div class="d-flex align-items-center mb-1">
                                <div class="text-warning me-2" style="font-size: 12px;">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <i class="@(i < int.Parse(item.Star) ? "fas fa-star" : "far fa-star")"></i>
                                    }
                                </div>
                                <span class="text-muted small">(@item.Star.Substring(0, 1))</span>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">@item.Name</h5>
                            <div class="d-flex align-items-center mb-3">
                                <span class="price-text me-2">₺@item.Price</span>
                                <del class="text-muted small">₺@((item.Price * 1.27m).ToString("0.00"))</del>
                            </div>
                        </div>

                        <div class="mt-auto">
                            <a asp-controller="Basket" asp-action="AddToCart" asp-route-id="@item.ProductId"
                               class="btn btn-outline-success w-100 rounded-pill fw-bold py-2 shadow-sm transition-all">
                                <i class="fas fa-cart-plus me-2"></i>Sepete Ekle
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link" href="/Product/Index?page=@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
    @await Component.InvokeAsync("_DefaultScriptComponentPartial")
</body>
</html>