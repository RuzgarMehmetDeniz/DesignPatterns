@model DesignPatterns.Entites.Testimonial
@{
    ViewData["Title"] = "Yorum Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <div class="text-center mb-4 border-bottom pb-3">
                    <img src="@Model.ImageUrl" class="rounded-circle shadow-sm mb-3" style="width: 80px; height: 80px; object-fit: cover; border: 3px solid #f8f9fa;">
                    <h5 class="fw-bold">Görüşü Düzenle</h5>
                </div>

                <form asp-action="UpdateTestimonial" method="post">
                    <input type="hidden" asp-for="TestimonialId" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold">İsim</label>
                        <input type="text" asp-for="Name" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Fotoğraf URL</label>
                        <input type="text" asp-for="ImageUrl" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-bold">Mesaj</label>
                        <textarea asp-for="Description" rows="6" class="form-control bg-light border-0" style="border-radius: 12px;">@Model.Description</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 shadow-sm">Güncellemeyi Tamamla</button>
                </form>
            </div>
        </div>
    </div>
</div>