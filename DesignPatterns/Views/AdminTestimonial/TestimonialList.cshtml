@model List<DesignPatterns.Entites.Testimonial>
@{
    ViewData["Title"] = "Müşteri Yorumları";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm" style="border-radius: 15px;">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center p-4">
            <h4 class="fw-bold m-0 text-dark"><i class="fas fa-quote-left text-success me-2"></i>Müşteri Deneyimleri</h4>
            <a href="/AdminTestimonial/CreateTestimonial" class="btn btn-success btn-sm rounded-pill px-4 shadow-sm">
                <i class="fas fa-plus me-2"></i>Yeni Yorum Ekle
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4">Müşteri</th>
                            <th>Yorum Özeti</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <img src="@item.ImageUrl" class="rounded-circle me-3 shadow-sm" style="width: 45px; height: 45px; object-fit: cover; border: 2px solid #eee;">
                                        <span class="fw-bold text-dark">@item.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <p class="small text-muted mb-0 text-truncate" style="max-width: 400px;">
                                        <i class="fas fa-quote-left me-1 opacity-50"></i>@item.Description
                                    </p>
                                </td>
                                <td class="text-center">
                                    <a href="/AdminTestimonial/UpdateTestimonial/@item.TestimonialId" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">Düzenle</a>
                                    <a href="/AdminTestimonial/DeleteTestimonial/@item.TestimonialId" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Bu yorumu silmek istediğinize emin misiniz?')">Sil</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>