@model DesignPatterns.Entites.Testimonial
@{
    ViewData["Title"] = "Yeni Referans";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <h5 class="fw-bold mb-4 border-bottom pb-3">Müşteri Yorumu Ekle</h5>
                <form asp-action="CreateTestimonial" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Müşteri Adı / Ünvanı</label>
                        <input type="text" asp-for="Name" class="form-control bg-light border-0 py-2" placeholder="Örn: Ahmet Yılmaz - CEO" style="border-radius: 10px;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Profil Fotoğrafı URL</label>
                        <input type="text" asp-for="ImageUrl" class="form-control bg-light border-0 py-2" placeholder="https://..." style="border-radius: 10px;">
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-bold">Deneyim Mesajı</label>
                        <textarea asp-for="Description" rows="5" class="form-control bg-light border-0" placeholder="Müşterinin görüşlerini buraya yazın..." style="border-radius: 12px;"></textarea>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-success text-white rounded-pill py-2 shadow">Yorumu Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>