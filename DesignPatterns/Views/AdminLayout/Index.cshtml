@{
    Layout = null;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

@await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")


<!-- ═══════════════════════════════════════
     ADMIN SHELL LAYOUT
═══════════════════════════════════════ -->
<div class="admin-shell">

    <!-- ── SIDEBAR ── -->
    <aside class="km-sidebar" id="kmSidebar">

        <a href="/AdminProduct/ProductList" class="km-sidebar-brand">
            <div class="km-brand-logo"><i class="fa-solid fa-seedling"></i></div>
            <div class="km-brand-text">
                <div class="km-brand-name">OrganikMarket</div>
                <div class="km-brand-tagline">Admin Paneli</div>
            </div>
        </a>

        <nav class="km-sidebar-nav">

            <div class="km-nav-section-label">Mağaza Yönetimi</div>

            <a href="/AdminProduct/ProductList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-box-open"></i></div>
                <span class="km-nav-label">Ürünler</span>
            </a>

            <a href="/AdminCategory/CategoryList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-layer-group"></i></div>
                <span class="km-nav-label">Kategoriler</span>
            </a>

            <div class="km-sidebar-divider"></div>
            <div class="km-nav-section-label">Görünüm & İçerik</div>

            <a href="/AdminBanner/BannerList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-image"></i></div>
                <span class="km-nav-label">Banner (Afiş)</span>
            </a>

            <a href="/AdminAbout/AboutList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-circle-info"></i></div>
                <span class="km-nav-label">Hakkımızda</span>
            </a>

            <a href="/AdminBlog/BlogList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-blog"></i></div>
                <span class="km-nav-label">Blog Yazıları</span>
            </a>

            <a href="/AdminService/ServiceList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-concierge-bell"></i></div>
                <span class="km-nav-label">Hizmetlerimiz</span>
            </a>

            <div class="km-sidebar-divider"></div>
            <div class="km-nav-section-label">Pazarlama & Güven</div>

            <a href="/AdminSale/SaleList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-tag"></i></div>
                <span class="km-nav-label">Kampanyalar</span>
            </a>

            <a href="/AdminTrend/TrendList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-fire"></i></div>
                <span class="km-nav-label">Trendler</span>
            </a>

            <a href="/AdminTestimonial/TestimonialList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-comments"></i></div>
                <span class="km-nav-label">Müşteri Yorumları</span>
            </a>

            <a href="/AdminBrand/BrandList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-copyright"></i></div>
                <span class="km-nav-label">Markalarımız</span>
            </a>

            <div class="km-sidebar-divider"></div>
            <div class="km-nav-section-label">Kurumsal</div>

            <a href="/AdminQuality/QualityList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-award"></i></div>
                <span class="km-nav-label">Kalite Politikamız</span>
            </a>

            <a href="/AdminCustomerProcess/ProcessList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-arrows-spin"></i></div>
                <span class="km-nav-label">İşleyiş Süreci</span>
            </a>

            <a href="/AdminSocialMedia/SocialMediaList" class="km-nav-item">
                <div class="km-nav-icon"><i class="fa-solid fa-share-nodes"></i></div>
                <span class="km-nav-label">Sosyal Medya</span>
            </a>

            <div class="km-sidebar-divider"></div>

            <a href="/Default/Index" class="km-nav-item" style="margin-top: 0.3rem;">
                <div class="km-nav-icon" style="color: rgba(244,67,54,0.7)"><i class="fa-solid fa-right-from-bracket"></i></div>
                <span class="km-nav-label" style="color: rgba(244,67,54,0.7)">Ana Sayfaya Dön</span>
            </a>

        </nav>

        <div class="km-sidebar-footer">
            <a href="/Admin/Profile" class="km-user-card">
                <div class="km-user-avatar">AY</div>
                <div>
                    <div class="km-user-name">Admin Yönetici</div>
                    <div class="km-user-role">Süper Admin</div>
                </div>
                <i class="fa-solid fa-ellipsis-vertical km-user-chevron"></i>
            </a>
        </div>

    </aside>

    <!-- ── MAIN ── -->
    <div class="km-main">

        <!-- Top Navbar -->
        @await Component.InvokeAsync("_AdminLayoutNavbarComponentPartial")

        <!-- Page Content -->
        <div class="km-content">

            <!-- Orbs -->
            <div class="km-orb km-orb-1"></div>
            <div class="km-orb km-orb-2"></div>

            <div class="km-panel-root">

				@RenderBody()

            </div><!-- /.km-panel-root -->
        </div><!-- /.km-content -->
    </div><!-- /.km-main -->

</div><!-- /.admin-shell -->
<!-- Mobile sidebar toggle (pure href navigation, no JS required for basic use) -->
<button class="km-mobile-toggle" onclick="document.getElementById('kmSidebar').classList.toggle('open')" aria-label="Menüyü aç/kapat">
    <i class="fa-solid fa-bars"></i>
</button>