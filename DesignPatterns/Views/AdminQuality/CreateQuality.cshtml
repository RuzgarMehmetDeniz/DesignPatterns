@model DesignPatterns.Entites.Quality
@{
    ViewData["Title"] = "Yeni Özellik Bölümü";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h4 class="fw-bold m-0 text-dark">
                        <i class="fas fa-plus-circle text-success me-2"></i>Yeni Kalite & Özellik Alanı Oluştur
                    </h4>
                    <a href="/AdminQuality/QualityList" class="btn btn-light btn-sm rounded-pill px-3">
                        <i class="fas fa-arrow-left me-1"></i> Listeye Dön
                    </a>
                </div>

                <form asp-action="CreateQuality" method="post">
                    <div class="card bg-light border-0 p-4 mb-4" style="border-radius: 15px;">
                        <h6 class="fw-bold text-uppercase small text-muted mb-3">Genel Görünüm</h6>
                        <div class="row">
                            <div class="col-12">
                                <label class="form-label small fw-bold">Ana Görsel URL (Arka Plan veya Büyük Resim)</label>
                                <input type="text" asp-for="MainImageUrl" class="form-control border-0 py-2 shadow-none" placeholder="https://..." style="border-radius: 10px;">
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 border rounded-4 bg-white shadow-sm">
                                <h6 class="fw-bold text-success border-bottom pb-2 mb-3">1. Özellik</h6>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Başlık</label>
                                    <input type="text" asp-for="Title1" class="form-control bg-light border-0 py-2" style="border-radius: 8px;">
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">İkon/Resim URL</label>
                                    <input type="text" asp-for="ImageUrl1" class="form-control bg-light border-0 py-2" style="border-radius: 8px;">
                                </div>
                                <div class="mb-0">
                                    <label class="form-label small fw-bold">Açıklama</label>
                                    <textarea asp-for="Description1" rows="2" class="form-control bg-light border-0" style="border-radius: 8px;"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 border rounded-4 bg-white shadow-sm">
                                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">2. Özellik</h6>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Başlık</label>
                                    <input type="text" asp-for="Title2" class="form-control bg-light border-0 py-2" style="border-radius: 8px;">
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">İkon/Resim URL</label>
                                    <input type="text" asp-for="ImageUrl2" class="form-control bg-light border-0 py-2" style="border-radius: 8px;">
                                </div>
                                <div class="mb-0">
                                    <label class="form-label small fw-bold">Açıklama</label>
                                    <textarea asp-for="Description2" rows="2" class="form-control bg-light border-0" style="border-radius: 8px;"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 border rounded-4 bg-white shadow-sm">
                                <h6 class="fw-bold text-info border-bottom pb-2 mb-3">3. Özellik</h6>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Başlık</label>
                                    <input type="text" asp-for="Title3" class="form-control bg-light border-0 py-2" style="border-radius: 8px;">
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">İkon/Resim URL</label>
                                    <input type="text" asp-for="ImageUrl3" class="form-control bg-light border-0 py-2" style="border-radius: 8px;">
                                </div>
                                <div class="mb-0">
                                    <label class="form-label small fw-bold">Açıklama</label>
                                    <textarea asp-for="Description3" rows="2" class="form-control bg-light border-0" style="border-radius: 8px;"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 border rounded-4 bg-white shadow-sm">
                                <h6 class="fw-bold text-warning border-bottom pb-2 mb-3">4. Özellik</h6>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Başlık</label>
                                    <input type="text" asp-for="Title4" class="form-control bg-light border-0 py-2" style="border-radius: 8px;">
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">İkon/Resim URL</label>
                                    <input type="text" asp-for="ImageUrl4" class="form-control bg-light border-0 py-2" style="border-radius: 8px;">
                                </div>
                                <div class="mb-0">
                                    <label class="form-label small fw-bold">Açıklama</label>
                                    <textarea asp-for="Description4" rows="2" class="form-control bg-light border-0" style="border-radius: 8px;"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 text-end border-top pt-4">
                        <button type="reset" class="btn btn-light rounded-pill px-4 me-2">Temizle</button>
                        <button type="submit" class="btn btn-success rounded-pill px-5 py-2 shadow-sm fw-bold">
                            Tüm İçeriği Yayınla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>