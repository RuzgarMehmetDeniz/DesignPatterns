@model DesignPatterns.Entites.Product
@{
    ViewData["Title"] = "Ürün Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <h5 class="fw-bold mb-4 border-bottom pb-3">Yeni Ürün Ekle</h5>
                <form asp-action="CreateProduct" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Ürün Adı</label>
                            <input type="text" asp-for="Name" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Kategori Seçin</label>
                            @Html.DropDownListFor(x => x.CategoryId, (IEnumerable<SelectListItem>)ViewBag.CategoryList, "Kategori Seçiniz", new { @class = "form-select bg-light border-0 py-2", style = "border-radius: 10px;" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Fiyat (₺)</label>
                            <input type="text" asp-for="Price" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Yıldız Sayısı (1-5)</label>
                            <input type="number" asp-for="Star" class="form-control bg-light border-0 py-2" min="1" max="5" style="border-radius: 10px;">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Görsel URL</label>
                            <input type="text" asp-for="ImageUrl" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-12 mt-4 text-end">
                            <button type="submit" class="btn btn-warning text-white rounded-pill px-5 shadow">Ürünü Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>