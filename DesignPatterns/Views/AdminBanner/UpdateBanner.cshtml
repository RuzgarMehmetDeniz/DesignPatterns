@model DesignPatterns.Entites.Banner
@{
    ViewData["Title"] = "Banner Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h5 class="fw-bold m-0 text-dark">Banner Bilgilerini Güncelle</h5>
                    <img src="@Model.ImageUrl" class="rounded shadow-sm" style="height: 40px; width: 80px; object-fit: cover;">
                </div>

                <form asp-action="UpdateBanner" method="post">
                    <input type="hidden" asp-for="BannerId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Banner Başlık (Ana)</label>
                            <input type="text" asp-for="BannerTitle" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Banner Başlık (Alt)</label>
                            <input type="text" asp-for="BannerTitle2" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Görsel URL</label>
                            <input type="text" asp-for="ImageUrl" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Banner Açıklaması</label>
                            <textarea asp-for="Description" rows="4" class="form-control bg-light border-0" style="border-radius: 15px;"></textarea>
                        </div>
                        <div class="col-12 mt-4 text-end">
                            <button type="submit" class="btn btn-info text-white rounded-pill px-5 shadow-sm">Değişiklikleri Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>