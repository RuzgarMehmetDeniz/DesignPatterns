@model DesignPatterns.Entites.Banner
@{
    ViewData["Title"] = "Yeni Banner";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <h5 class="fw-bold mb-4 border-bottom pb-3 text-primary">Yeni Banner Oluştur</h5>
                <form asp-action="CreateBanner" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Banner Başlık (Ana)</label>
                            <input type="text" asp-for="BannerTitle" class="form-control bg-light border-0 py-2" placeholder="Örn: Taze Ürünler" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Banner Başlık (Alt)</label>
                            <input type="text" asp-for="BannerTitle2" class="form-control bg-light border-0 py-2" placeholder="Örn: %20 İndirim" style="border-radius: 10px;">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Görsel URL</label>
                            <input type="text" asp-for="ImageUrl" class="form-control bg-light border-0 py-2" placeholder="https://..." style="border-radius: 10px;">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Banner Açıklaması</label>
                            <textarea asp-for="Description" rows="4" class="form-control bg-light border-0" placeholder="Kısa reklam metni..." style="border-radius: 15px;"></textarea>
                        </div>
                        <div class="col-12 mt-4 text-end">
                            <a href="/AdminBanner/BannerList" class="btn btn-light rounded-pill px-4 me-2">Vazgeç</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow">Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>