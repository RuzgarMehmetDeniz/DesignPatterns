@model List<CustomerProcess>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Dinamik Veri Yönetim Paneli</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-5">
        <h2 class="text-center mb-4">Müşteri İşlem Takip Paneli</h2>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">
                @TempData["Message"]
            </div>
        }

        <table class="table table-bordered table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>#</th>
                    <th>Müşteri Adı</th>
                    <th>Tutar</th>
                    <th>Personel</th>
                    <th>Açıklama</th>
                    <th>Observer İşlemi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CustomerProcessId</td>
                        <td>@item.CustomerName</td>
                        <td>@item.Amount.ToString("C2")</td>
                        <td>@item.EmployeeName</td>
                        <td>@item.Description</td>
                        <td>
                            <!-- Farklı bir Controller olan ObserverController'ı tetikleyen buton -->
                            <form asp-controller="Observer" asp-action="NotifyCustomer" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.CustomerProcessId" />
                                <button type="submit" class="btn btn-sm btn-info shadow-sm">
                                    Bildirim Gönder
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-right">
            <a href="/CustomerProcess/AddProcess" class="btn btn-primary">Yeni İşlem Ekle</a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>