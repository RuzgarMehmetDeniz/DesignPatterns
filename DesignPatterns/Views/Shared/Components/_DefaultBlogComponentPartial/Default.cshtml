@model List<Blog>
<section class="blog_section sec_space_xlarge position-relative" data-aos="fade-up"
		 data-aos-duration="2000">
	<div class="blog_section_wrap">
		<div class="container-fluid-full ">
			@* Başlık Alanı *@
			<div class="quality_top_content text-center">
				<div class="quality_sub_title d-flex justify-content-center align-items-center pb-2">
					<i class="far fa-circle"></i>
					<i class="far fa-circle"></i>
					<i class="far fa-circle"></i>
					<span class="px-2">
						ÇİFTLİĞİMİZDEN TAZE
					</span>
					<i class="far fa-circle"></i>
					<i class="far fa-circle"></i>
					<i class="far fa-circle"></i>
				</div>
				<div class="blog_top_title pb-5">
					<h2>Son Blog Yazısı</h2>
				</div>
			</div>

			@if (Model != null && Model.Count >= 4)
			{
				@* İlk Satır: Resim-Metin-Resim-Metin *@
				<div class="row p-0">
					@for (int i = 0; i < 2; i++)
					{
						var item = Model[i];
						@* Görsel Alanı *@
						<div class="col-md-6 col-xl-3 p-0">
							<a class="d-block" href="/Blog/Detail/@item.BlogId">
								<div class="blog_content_thumb"
									 style="background-image: url(@item.ImageUrl1);"
									 data-aos="fade-right" data-aos-duration="1000">
								</div>
							</a>
						</div>
						@* Metin Alanı *@
						<div class="col-md-6 col-xl-3 p-0">
							<div class="blog_content_text d-flex flex-column justify-content-center align-items-center text-center"
								 data-aos="fade-right" data-aos-duration="1500">
								<div class="blog_subtitle text-uppercase d-inline-block">
									<h6 class="text-white">@item.Title1</h6>
								</div>
								<div class="blog_title pt-3">
									<a href="/Blog/Detail/@item.BlogId">
										<h2>@item.Title2</h2>
									</a>
								</div>
								<div class="blog_icon">
									<img src="@item.ImageUrl2" alt="icon">
								</div>
								<div class="blog_author_cnt d-flex justify-content-center align-items-center">
									<span><i class="far fa-calendar-alt"></i> By Admin</span>
									<font class="px-3">-</font>
									<span><i class="fas fa-comment"></i> 2 Yorum</span>
								</div>
								<div class="blog_desc py-3">
									<p>@item.Description</p>
								</div>
							</div>
						</div>
					}
				</div>

				@* İkinci Satır: Metin-Resim-Metin-Resim (Çapraz Düzen) *@
				<div class="row p-0">
					@for (int i = 2; i < 4; i++)
					{
						var item = Model[i];
						@* Metin Alanı (Önce Metin Geliyor) *@
						<div class="col-md-6 col-xl-3 p-0 order-2 order-md-0">
							<div class="blog_content_text d-flex flex-column justify-content-center align-items-center text-center"
								 data-aos="fade-left" data-aos-duration="1000">
								<div class="blog_subtitle text-uppercase d-inline-block">
									<h6 class="text-white">@item.Title1</h6>
								</div>
								<div class="blog_title pt-3">
									<a href="/Blog/Detail/@item.BlogId">
										<h2>@item.Title2</h2>
									</a>
								</div>
								<div class="blog_icon">
									<img src="@item.ImageUrl2" alt="icon">
								</div>
								<div class="blog_author_cnt d-flex justify-content-center align-items-center">
									<span><i class="far fa-calendar-alt"></i> By Admin</span>
									<font class="px-3">-</font>
									<span><i class="fas fa-comment"></i> 0 Yorum</span>
								</div>
								<div class="blog_desc py-3">
									<p>@item.Description</p>
								</div>
							</div>
						</div>
						@* Görsel Alanı *@
						<div class="col-md-6 col-xl-3 p-0 order-1 order-md-0">
							<a class="d-block" href="/Blog/Detail/@item.BlogId">
								<div class="blog_content_thumb"
									 style="background-image: url(@item.ImageUrl1);"
									 data-aos="fade-left" data-aos-duration="1500">
								</div>
							</a>
						</div>
					}
				</div>
			}
		</div>
	</div>
</section>
