<header class="header_section position-relative header_2">
    <div class="header_bottom_main">
        <div class="container">
            <div class="webMenu d-none d-lg-block">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <!-- Logo: Varsayılan ana sayfaya yönlendirir -->
                    <a class="navbar-brand" asp-controller="Default" asp-action="Index">
                        <img src="/Organic/organic-html/assets/images/logo/logo.png" alt="Logo">
                    </a>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav main_menu_list m-auto">
                            <!-- 1. DEFAULT ANA SAYFA -->
                            <li class="nav-item px-2">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Default" ? "active" : "")"
                                   asp-controller="Default"
                                   asp-action="Index">Ana Sayfa</a>
                            </li>

                            <!-- 2. PRODUCT ÜRÜNLER -->
                            <li class="nav-item px-2">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")"
                                   asp-controller="Product"
                                   asp-action="Index">Ürünler</a>
                            </li>

                            <!-- 3. BASKET SEPETİM -->
                            <li class="nav-item px-2">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Basket" ? "active" : "")"
                                   asp-controller="Basket"
                                   asp-action="Index">Sepetim</a>
                            </li>
                        </ul>

                        <!-- Sağ taraftaki sepet ikonu -->
                        <div class="header_icons d-flex align-items-center">
                            <a asp-controller="Basket" asp-action="Index" class="position-relative text-dark">
                                <i class="fas fa-shopping-basket fa-lg"></i>
                            </a>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </div>
</header>