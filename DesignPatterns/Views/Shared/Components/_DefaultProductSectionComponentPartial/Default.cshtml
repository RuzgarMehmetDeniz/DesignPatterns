@model List<Product>
<section class="product_section home2_product_sec" data-aos="fade-up" data-aos-duration="2000">
	<div class="container">
		@* Başlık Alanı *@
		<div class="row">
			<div class="col-lg-6">
				<div class="product_sec_content">
					<div class="product_sec_sub_title d-flex align-items-center pb-2">
						<i class="far fa-circle"></i>
						<i class="far fa-circle"></i>
						<i class="far fa-circle"></i>
						<span class="ps-1">
							ÇİFTLİĞİMİZDEN TAZE
						</span>
					</div>
					<h2 class="product_sec_title pb-3">Organik Ürünler</h2>
				</div>
			</div>
			<div class="col-lg-6 text-center text-lg-end">
				<a href="#!">
					<button type="button"
							class="btn custom_btn rounded-pill px-4 py-2  text-white">
						Daha Fazlasını Keşfet <i class="fas fa-long-arrow-alt-right"></i>
					</button>
				</a>
			</div>
		</div>
		@* Ürün Listeleme Alanı *@
		<div class="row g-4">

			@foreach (var item in Model)
			{
				<div class="col-sm-6 col-md-6 col-xl-3 mb-4">
					<div class="product_layout_2 overflow-hidden position-relative">
						<div class="product_layout_content bg-white position-relative">
							<div class="product_image_wrap">
								<a class="product_image d-flex justify-content-center align-items-center"
								   href="/Product/Detail/@item.ProductId">
									@* Dinamik Resimler *@
									<img class="pic-1" src="@item.ImageUrl" alt="@item.Name">
									<img class="pic-2" src="@item.ImageUrl" alt="@item.Name">
								</a>

								<ul class="product_badge_group ul_li_block">
									<li>
										<span class="product_badge badge_meats position-absolute rounded-pill text-uppercase">Et Ürünü</span>
									</li>
								</ul>

								<ul class="product_action_btns ul_li_block d-flex">
									<li><a class="tooltips" title="Ürünü İncele" href="#!"><i class="fas fa-search"></i></a></li>
									<li><a class="tooltips" title="Sepete Ekle" href="#!"><i class="fas fa-shopping-bag"></i></a></li>
								</ul>
							</div>

							@* YILDIZ DÖNGÜSÜ (INT OLARAK) *@
							<div class="rating_wrap d-flex">
								<ul class="rating_star ul_li">
									@{
										// String gelen Star değerini int'e çeviriyoruz
										int starCount = 0;
										int.TryParse(item.Star, out starCount);
									}

									@for (int i = 1; i <= 5; i++)
									{
										if (i <= starCount)
										{
											<li class="active"><i class="fas fa-star"></i></li>
										}
										else
										{
											<li><i class="far fa-star"></i></li>
										}
									}
								</ul>
								<span class="shop_review_text">( @starCount.0 )</span>
							</div>

							<div class="product_content">
								<h3 class="product_title">
									<a href="/Product/Detail/@item.ProductId">@item.Name</a>
								</h3>
								<div class="product_price">
									<span class="sale_price pe-1">@item.Price.ToString("C2")</span>
									@* İsterseniz buraya indirimli fiyat mantığı eklenebilir *@
									<del>@( (item.Price * 1.2m).ToString("C2") )</del>
								</div>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
</section>
