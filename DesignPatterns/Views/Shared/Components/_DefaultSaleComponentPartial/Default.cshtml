@model DesignPatterns.Entites.Sale

<section class="sale2_section" data-aos="fade-up" data-aos-duration="2000">
    @if (Model != null)
    {
        <div class="sale2_section_wrap sec_space_xxlarge d-flex justify-content-center align-items-center"
             style="background-image: url(@Model.ImageUrl)">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6"></div>

                    @* Satış Alanı *@
                    <div class="col-lg-6">
                        <div class="sale2_content_wrap ps-3">

                            @* Yeşil Şekilli Üst Başlık *@
                            <div class="sale2_sub_title pb-3 position-relative">
                                <img class="sub_title_bg" src="/Organic/organic-html/assets/images/shapes/shape2.png"
                                     alt="image_not_found">
                                <h6 class="text-white text-uppercase position-absolute">
                                    @Model.Title1
                                </h6>
                            </div>

                            @* Dinamik Harf Efektli Ana Başlık *@
                            <div class="sale2_title py-2">
                                <h2>
                                    @* Başlığın statik kısmını Model'den alıyoruz *@
                                    @Model.Title2 <br>

                                    <font class="text-effect">
                                        @foreach (var charItem in "Meyve Ürünleri")
                                        {
                                            if (charItem == ' ')
                                            {
                                                <span>&nbsp;</span>
                                            }
                                            else
                                            {
                                                <span>@charItem</span>
                                            }
                                        }
                                    </font>
                                </h2>
                            </div>

                            @* Dinamik Açıklama *@
                            <div class="sale2_desc">
                                <p>
                                    @Model.Description
                                </p>
                            </div>

                            @* Buton *@
                            <div class="sale2_btn load_more_3">
                                <a href="/Product/Index">
                                    <button type="button"
                                            class="btn custom_btn rounded-pill px-5 py-3 text-white">
                                        Daha Fazlası <i class="fas fa-long-arrow-alt-right"></i>
                                    </button>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</section>