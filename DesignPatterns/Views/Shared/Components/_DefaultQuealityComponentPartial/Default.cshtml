@model Quality
<section class="quality_section2 position-relative sec_space_small" data-aos="fade-up"
         data-aos-duration="2000">
    <div class="quality_section_wrap2">
        <div class="container">
            <div class="quality_top_content text-center">
                <div class="quality_sub_title d-flex justify-content-center align-items-center pb-2">
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                    <span class="px-2">
                        TARLAMIZDAN TAZE HASAT
                    </span>
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                </div>
                <div class="quality_top_title2 pb-5">
                    <h2>Taze Ürünler</h2>
                </div>
            </div>
            @* Kalite Alanı *@
            <div class="quality_inner_content2 position-relative">
                <div class="quality_content2_img1 position-absolute d-flex justify-content-center align-items-center text-end" data-aos="fade-left"
                     data-aos-duration="1000">
                    <div class="quality_text">
                        <div class="quality_title2">
                            <h4 class="text-uppercase">@Model.Title1</h4>
                        </div>
                        <div class="quality_desc2">
                            <p>@Model.Description1</p>
                        </div>
                    </div>
                    <div class="quality_img2 d-flex justify-content-center align-items-center ms-4">
                        <img src="@Model.ImageUrl1" alt="image_not_found">
                    </div>
                </div>
                <div class="quality_content2_img2 position-absolute d-flex justify-content-center align-items-center" data-aos="fade-left"
                     data-aos-duration="1500">
                    <div class="quality_img2 d-flex justify-content-center align-items-center me-4">
                        <img src="@Model.ImageUrl2" alt="image_not_found">
                    </div>
                    <div class="quality_text">
                        <div class="quality_title2">
                            <h4 class="text-uppercase">@Model.Title2</h4>
                        </div>
                        <div class="quality_desc2">
                            <p>@Model.Description2</p>
                        </div>
                    </div>
                </div>
                <div class="quality_middle_gallery2 img_moving_anim1 text-center">
                    <img src="@Model.MainImageUrl" alt="image_not_found">
                </div>
                <div class="quality_content2_img3 position-absolute d-flex justify-content-center align-items-center" data-aos="fade-right"
                     data-aos-duration="1000">
                    <div class="quality_text text-end">
                        <div class="quality_title2 ">
                            <h4 class="text-uppercase">@Model.Title3</h4>
                        </div>
                        <div class="quality_desc2">
                            <p>@Model.Description3</p>
                        </div>
                    </div>
                    <div class="quality_img2 d-flex justify-content-center align-items-center ms-4">
                        <img src="@Model.ImageUrl3" alt="image_not_found">
                    </div>
                </div>
                <div class="quality_content2_img4 position-absolute d-flex justify-content-center align-items-center" data-aos="fade-right"
                     data-aos-duration="1500">
                    <div class="quality_img2 d-flex justify-content-center align-items-center me-4">
                        <img src="@Model.ImageUrl4" alt="image_not_found">
                    </div>
                    <div class="quality_text">
                        <div class="quality_title2">
                            <h4 class="text-uppercase">@Model.Title4</h4>
                        </div>
                        <div class="quality_desc2">
                            <p>@Model.Description4</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- quality side img start -->
    <img class="quality2_left_thumb position-absolute" src="/Organic/organic-html/assets/images/shapes/shape19.png"
         alt="image_not_found">
    <img class="quality2_righttop_thumb position-absolute" src="/Organic/organic-html/assets/images/shapes/shape7.png"
         alt="image_not_found">
    <img class="quality2_rightbottom_thumb position-absolute" src="/Organic/organic-html/assets/images/shapes/shape10.png"
         alt="image_not_found">
    <!-- quality side img end -->
</section>
