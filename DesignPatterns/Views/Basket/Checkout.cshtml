@model CheckoutViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Güvenli Ödeme - Organic Food</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/all.min.css">

    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .checkout-container {
            margin-top: 50px;
            margin-bottom: 50px;
        }

        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .form-control {
            border-radius: 10px;
            padding: 12px;
            border: 1px solid #dee2e6;
            margin-bottom: 5px;
        }

            .form-control:focus {
                box-shadow: 0 0 0 0.25rem rgba(40, 167, 69, 0.1);
                border-color: #28a745;
            }

        .btn-success {
            background-color: #28a745;
            border: none;
            border-radius: 12px;
            padding: 15px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-success:hover {
                background-color: #218838;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
            }

        .order-summary {
            background-color: #ffffff;
            border-left: 5px solid #28a745;
        }

        .item-row {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        /* Ödeme Seçenekleri Stili */
        .payment-option {
            border: 2px solid #eee;
            border-radius: 12px;
            padding: 15px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
        }

            .payment-option:hover {
                border-color: #28a745;
                background-color: #f8fff9;
            }

            .payment-option input {
                display: none;
            }

                .payment-option input:checked + label {
                    color: #28a745;
                    font-weight: bold;
                }

                .payment-option input:checked ~ .option-card {
                    border-color: #28a745;
                    background-color: #f8fff9;
                }

        input[type="radio"]:checked + .payment-content {
            border-color: #28a745;
            background-color: #f8fff9;
        }
    </style>
</head>

@await Component.InvokeAsync("_DefaultHeaderComponentPartial")

<body>

    <div class="container checkout-container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Ödeme Sayfası</h2>
            <p class="text-muted">Siparişinizi tamamlamak için bilgilerinizi ve ödeme yönteminizi seçiniz.</p>
        </div>

        <div class="row g-4">
            <!-- Müşteri ve Ödeme Bilgileri Formu -->
            <div class="col-lg-7">
                <div class="card p-4">
                    <form asp-controller="Basket" asp-action="Checkout" method="post">

                        <h4 class="mb-4 text-success"><i class="fas fa-user-circle me-2"></i>Müşteri Bilgileri</h4>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ad Soyad</label>
                            <input type="text" asp-for="FullName" class="form-control" placeholder="Örn: Ahmet Yılmaz" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">E-posta</label>
                                <input type="email" asp-for="Email" class="form-control" placeholder="ahmet@example.com" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Telefon</label>
                                <input type="tel" asp-for="PhoneNumber" class="form-control" placeholder="05XX XXX XX XX" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Şehir</label>
                            <input type="text" asp-for="City" class="form-control" placeholder="Şehir seçiniz" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Adres</label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Sokak, Mahalle..." required></textarea>
                        </div>

                        <!-- STRATEGY PATTERN: Ödeme Seçenekleri -->
                        <h4 class="mt-5 mb-4 text-success"><i class="fas fa-credit-card me-2"></i>Ödeme Yöntemi Seçin</h4>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <input type="radio" class="btn-check" name="paymentType" id="creditCard" value="CreditCard" checked autocomplete="off">
                                <label class="btn btn-outline-success w-100 p-3" for="creditCard">
                                    <i class="fas fa-credit-card d-block mb-2 fa-2x"></i>
                                    Kredi Kartı
                                </label>
                            </div>
                            <div class="col-md-6">
                                <input type="radio" class="btn-check" name="paymentType" id="bankTransfer" value="BankTransfer" autocomplete="off">
                                <label class="btn btn-outline-success w-100 p-3" for="bankTransfer">
                                    <i class="fas fa-university d-block mb-2 fa-2x"></i>
                                    Havale / EFT
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 mt-3 text-uppercase">
                            Siparişi Tamamla
                        </button>
                    </form>
                </div>
            </div>

            <!-- Sipariş Özeti -->
            <div class="col-lg-5">
                <div class="card p-4 order-summary">
                    <h4 class="mb-4 text-success"><i class="fas fa-shopping-bag me-2"></i>Sipariş Özeti</h4>
                    <div class="mb-3">
                        @if (Model.CartItems != null && Model.CartItems.Any())
                        {
                            @foreach (var item in Model.CartItems)
                            {
                                <div class="d-flex justify-content-between align-items-center item-row">
                                    <div>
                                        <span class="fw-bold d-block">@item.ProductName</span>
                                        <small class="text-muted">Adet: @item.Quantity</small>
                                    </div>
                                    <span class="fw-semibold">@((item.Price * item.Quantity).ToString("C2"))</span>
                                </div>
                            }
                        }
                    </div>

                    <div class="mt-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Ara Toplam</span>
                            <span>@Model.GrandTotal.ToString("C2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5 fw-bold">Genel Toplam</span>
                            <span class="h5 fw-bold text-success">@Model.GrandTotal.ToString("C2")</span>
                        </div>
                        <div class="alert alert-light border-0 small text-center">
                            <i class="fas fa-lock me-1"></i> 256-bit SSL Güvenli Ödeme
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

@await Component.InvokeAsync("_DefaultScriptComponentPartial")

</html>