@model DesignPatterns.Entites.Blog
@{
    ViewData["Title"] = "Yeni Blog";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <h5 class="fw-bold mb-4 border-bottom pb-3">Yeni Blog Yazısı Oluştur</h5>
                <form asp-action="CreateBlog" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Ana Başlık (Title1)</label>
                            <input type="text" asp-for="Title1" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Alt Başlık (Title2)</label>
                            <input type="text" asp-for="Title2" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Kapak Görsel URL (ImageUrl1)</label>
                            <input type="text" asp-for="ImageUrl1" class="form-control bg-light border-0 py-2" placeholder="https://..." style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Detay Görsel URL (ImageUrl2)</label>
                            <input type="text" asp-for="ImageUrl2" class="form-control bg-light border-0 py-2" placeholder="https://..." style="border-radius: 10px;">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Blog İçeriği</label>
                            <textarea asp-for="Description" rows="8" class="form-control bg-light border-0" style="border-radius: 15px;"></textarea>
                        </div>
                        <div class="col-12 mt-4 text-end">
                            <a href="/AdminBlog/BlogList" class="btn btn-link text-secondary text-decoration-none me-3">Vazgeç</a>
                            <button type="submit" class="btn btn-dark rounded-pill px-5 shadow">Yazıyı Yayınla</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>