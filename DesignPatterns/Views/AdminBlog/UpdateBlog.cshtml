@model DesignPatterns.Entites.Blog
@{
    ViewData["Title"] = "Blog Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h5 class="fw-bold m-0">Blog Yazısını Güncelle</h5>
                    <span class="badge bg-dark rounded-pill px-3">ID: @Model.BlogId</span>
                </div>

                <form asp-action="UpdateBlog" method="post">
                    <input type="hidden" asp-for="BlogId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Ana Başlık</label>
                            <input type="text" asp-for="Title1" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Alt Başlık</label>
                            <input type="text" asp-for="Title2" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Görsel 1</label>
                            <input type="text" asp-for="ImageUrl1" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Görsel 2</label>
                            <input type="text" asp-for="ImageUrl2" class="form-control bg-light border-0 py-2" style="border-radius: 10px;">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">İçerik Metni</label>
                            <textarea asp-for="Description" rows="10" class="form-control bg-light border-0" style="border-radius: 15px;"></textarea>
                        </div>
                        <div class="col-12 mt-4 text-end">
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 shadow-sm">Değişiklikleri Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>